{
  "name": "h5p-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "h5p-mcp": "dist/core/cli.js",
    "h5p-mcp-bun": "dist/core/cli.js"
  },
  "files": [
    "dist/core",
    "h5p_mcp/contracts/*.json",
    ".agents/skills/h5p-authoring",
    "LICENSE*",
    "NOTICE*"
  ],
  "packageManager": "bun@1.4.4",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "bun tests/tooling/build.mjs",
    "pack:local": "bun run build && bun tests/tooling/pack.mjs",
    "test": "bun test tests/core",
    "lint": "oxlint --deny-warnings src tests/core"
  },
  "dependencies": {
    "@modelcontextprotocol/hono": "2.0.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@node-rs/crc32": "1.10.8",
    "ajv": "8.20.0",
    "hono": "4.13.14",
    "jose": "6.2.14",
    "magic-bytes.js": "1.13.1",
    "probe-image-size": "7.4.0",
    "re2js": "2.9.1",
    "sanitize-html": "2.18.1",
    "saxes": "6.0.0",
    "yaml": "2.9.1",
    "yauzl-promise": "4.0.0",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "typescript": "7.0.2",
    "oxlint": "1.90.0"
  }
}
